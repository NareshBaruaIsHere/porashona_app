                <item android:offset="0.5" android:color="#22D3EE" />
                <item android:offset="1.0" android:color="#0EA5E9" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeWidth">
            <item android:offset="0.0" />
        </aapt:attr>
    </path>

    <!-- Outer Orbital Node Dot (at 3 o'clock) -->
    <path
        android:pathData="M87,54m-4.2,0a4.2,4.2 0 1,0 8.4,0a4.2,4.2 0 1,0 -8.4,0"
